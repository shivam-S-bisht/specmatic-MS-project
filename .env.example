# Copy to .env before the first run:  cp .env.example .env
#
# Nothing here is committed. In CI these come from the pipeline's secret store
# (GitHub Actions secrets); in production they would come from a vault
# (Vault / AWS Secrets Manager / GCP Secret Manager) injected as env vars.
# Both docker-compose.yaml and specmatic.yaml read them from the environment,
# so no credential ever lives inside a spec or a config file.
#
# Generate fresh values with:  openssl rand -hex 16

# API key enforced on DELETE /orders/{id} (apiKeyAuth scheme in order-api.yaml).
ORDER_API_KEY=replace-me-with-openssl-rand-hex-16

# Service-to-service bearer token for POST /payments (bearerAuth scheme in
# payment-api.yaml). Order Service presents it when charging a payment.
PAYMENT_SERVICE_TOKEN=replace-me-with-openssl-rand-hex-16
